{
  "name": "papersearcher",
  "private": true,
  "description": "PaperSearcher monorepo — run setup once, then npm run dev",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:mock": "npm --prefix frontend run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
