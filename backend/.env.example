APP_NAME=PaperSearcher API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paper_searcher
DATABASE_ECHO=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
LOG_JSON=false

VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_EMBEDDING_DIMENSION=1024

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

RETRIEVAL_MAX_DISTANCE=0.4
RETRIEVAL_TOP_K=5
