APP_NAME=PaperSearcher API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Shared central PostgreSQL (local Docker example). Production: set to your hosted URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paper_searcher
# Apply schema with Alembic (startup no longer runs create_all):
#   cd backend && alembic upgrade head
# Existing local DB that already has baseline tables from create_all:
#   alembic stamp 0000_baseline_schema && alembic upgrade head
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
LOG_JSON=false

VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_EMBEDDING_DIMENSION=1024

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

RETRIEVAL_MAX_DISTANCE=0.4
RETRIEVAL_TOP_K=5

# Database-first discovery cache
# Similarity = 1 - pgvector cosine_distance (higher is more similar).
SEARCH_CACHE_PAPER_SIMILARITY_THRESHOLD=0.60
SEARCH_CACHE_TOPIC_SIMILARITY_THRESHOLD=0.85
SEARCH_CACHE_MIN_RESULTS=5
SEARCH_CACHE_MAX_AGE_DAYS=14
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=50
SEARCH_CANDIDATE_MULTIPLIER=3
SEARCH_MAX_QUERY_LENGTH=500
