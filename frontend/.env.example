# Copy to .env.local for local development
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_PORT=5173
VITE_APP_NAME=PaperSearcher
# Set false to talk to FastAPI for projects / search / save
VITE_USE_MOCKS=false

# VITE_AUTH_MODE=mock signs in as a fixed local dev user, no Clerk account needed.
# VITE_AUTH_MODE=clerk shows real Clerk sign-in/sign-up; requires the key below
# and must match the backend's AUTH_MODE.
VITE_AUTH_MODE=mock
VITE_CLERK_PUBLISHABLE_KEY=
